{
  "manifest_version": 3,
  "name": "AgentMesh-OfficialRecruitment",
  "version": "0.6.6",
  "description": "连接 Agent、Chrome 与 Web，识别并辅助填写当前官网招聘页面",
  "key": "",
  "permissions": ["activeTab", "nativeMessaging", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8010/*",
    "http://localhost:8010/*",
    "http://127.0.0.1:8765/*",
    "https://agentmesh360.com/*",
    "https://*.agentmesh360.com/*"
  ],
  "action": {
    "default_title": "官网申请填写器",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
